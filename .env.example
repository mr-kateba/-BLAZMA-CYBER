# BLAZMA CYBER does NOT read API keys from .env in production.
# API keys are entered in Settings -> API Keys and encrypted locally with the
# operating system's credential protection (Windows DPAPI via Electron safeStorage).
#
# This file exists only to document optional development overrides.
# Never commit a real .env file.

# Force offline mode regardless of saved settings (1 = on)
BLAZMA_FORCE_OFFLINE=
# Override the data directory (useful for tests / portable dev runs)
BLAZMA_DATA_DIR=
